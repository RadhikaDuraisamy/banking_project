select 
    t.TRANSACTION_ID,
    t.ACCOUNT_ID,
    t.TRANSACTION_TIMESTAMP,
    t.TRANSACTION_TYPE,
    t.TRANSACTION_CHANNEL,
    t.AMOUNT,
    t.TRANSACTION_STATUS,
   a.ACCOUNT_TYPE,
