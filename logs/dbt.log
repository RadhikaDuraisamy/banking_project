Success_Transaction_Amount,
Avg_Success_Transaction_Amount,
loan_count,
active_loan_count,
TOTAL_PRINCIPAL_AMOUNT,
TOTAL_MONTHLY_EMI
avg_intrest_rate
from transaction_summary t left join loan_summary l on 
t.CUSTOMER_ID=l.CUSTOMER_ID
  )
